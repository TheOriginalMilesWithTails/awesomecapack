["Dynamic Explosions"]
	#Maksymalna ilość spadających bloków na jedną eksplozję (zabezpieczenie przed lagami).
	# Default: 2500
	# Range: 10 ~ 10000
	maxFallingBlocksPerExplosion = 2500
	#Czy niszczenie podstawy budowli (np. wieży) ma powodować jej fizyczne zawalenie i rozsypanie się?
	enableLargeStructuresCollapse = true
	#Jak mocno bloki mają się rozsypywać na boki przy zawalaniu się dużej struktury.
	# Default: 0.2
	# Range: 0.0 ~ 2.0
	physicsScatteringForce = 0.2
	#Zasięg od wybuchu, w jakim sprawdzana jest utrata podparcia struktur.
	# Default: 5
	# Range: 1 ~ 15
	instabilityRadius = 5
	#O ile najwyżej rośnie strefa zawalania przy wysokich budowlach. Strefa, w której nadwieszone bloki odpadają, rośnie o wysokość budowli ponad lejem (do tej wartości) - inaczej nad lejem zostają wiszące mosty i stojące filary.
	# Default: 32
	# Range: 1 ~ 64
	maxCollapseRadius = 32
	#Ile bloków ponad lejem jest analizowanych. Wyższe struktury bez podparcia są doczytywane tylko wtedy, gdy faktycznie mogą runąć (oszczędza wydajność pod ziemią).
	# Default: 16
	# Range: 4 ~ 64
	scanHeightAboveExplosion = 16
	#Szansa, że blok, który po wybuchu zawisł bezpośrednio nad lejem (sufit jaskini, spód latającej wyspy), odpadnie. 0 = wyłączone.
	# Default: 0.35
	# Range: 0.0 ~ 1.0
	looseBlockChance = 0.35
	#Czy bloki ponad limit maxFallingBlocksPerExplosion mają wypadać jako przedmioty (może powodować lagi). Kontenery zawsze wyrzucają zawartość.
	dropExcessBlocksAsItems = false
	#Co się dzieje z pojemnikami (skrzynie, beczki, shulkery, piece, lejki...), które straciły podparcie przy zawaleniu. Pojemnik nigdy nie podtrzymuje budowli i nigdy nie traci zawartości.
	#FALL - spada razem z zawartością (domyślnie)
	#STAY - zostaje na miejscu, zawartość nietknięta
	#BREAK - rozpada się i wyrzuca zawartość
	#Pojemniki trafione bezpośrednio wybuchem zachowują się jak w vanilli.
	#Allowed Values: STAY, FALL, BREAK
	containerCollapseMode = "FALL"
	#Wersja tego pliku - nie zmieniaj. Plik bez niej pochodzi z czasu, gdy STAY było domyślne.
	# Default: 0
	# Range: > 0
	configVersion = 2
